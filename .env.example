# Credenciales de acceso a SUNEDU SIU / PUNKU
SUNEDU_USERNAME=tu_correo_o_dni@unap.edu.pe
SUNEDU_PASSWORD=tu_contraseña_aqui

# URLs del sistema
SIU_BASE_URL=https://siu.sunedu.gob.pe
SIU_TARGET_URL=https://siu.sunedu.gob.pe/

# Configuración de ejecución del navegador
# True para modo silencioso en segundo plano, False para ver la ventana
HEADLESS=True

# Canal de navegador: "chrome" usa Google Chrome instalado, o vacío para Chromium
BROWSER_CHANNEL=chrome

# Archivo de persistencia de sesión
SESSION_FILE=auth_session.json
